# Database (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:password@localhost:5432/brainorth_med?schema=public"

# Authentication (session signing — generate with: openssl rand -base64 32)
AUTH_SECRET="generate-a-long-random-secret-here"
NEXTAUTH_URL="https://med.brainorth.com"

# WhatsApp Cloud API (Meta for Developers)
WHATSAPP_PHONE_NUMBER_ID="your_meta_phone_number_id"
WHATSAPP_ACCESS_TOKEN="your_meta_system_user_token"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="brainorth_webhook_secret"

# Document Storage (Supabase Storage / AWS S3 / Cloudflare R2)
STORAGE_BUCKET_NAME="brainorth-med-docs"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_ENDPOINT=""

