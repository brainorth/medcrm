datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum StaffRole {
  SUPERADMIN
  DOCTOR
  RECEPTIONIST
  NURSE
  LAB_TECH
  BILLING_OFFICER
}

enum AppointmentStatus {
  SCHEDULED
  CHECKED_IN
  IN_CONSULTATION
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  STRIPE
  RAZORPAY
  BANK_TRANSFER
}

enum CommChannel {
  WHATSAPP
  SMS
  EMAIL
}

enum CommDirection {
  OUTBOUND
  INBOUND
}

enum CommStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

// -------------------------------------------------------------
// 1. TENANCY & ACCESS CONTROL
// -------------------------------------------------------------

model Organization {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  slug         String   @unique
  logoUrl      String?  @map("logo_url")
  address      String?
  phone        String?
  email        String?
  currency     String   @default("INR")
  timezone     String   @default("Asia/Kolkata")

  // Indian GST & invoicing identity
  gstin         String? // Clinic GST registration number
  stateName     String? @map("state_name") // e.g. "Karnataka" — used for place of supply
  invoicePrefix String  @default("INV") @map("invoice_prefix") // e.g. "INV" -> "INV-2026-0001"

  // Feature Entitlements (e.g. {"whatsapp_automations": true, "telehealth": true})
  features     Json     @default("{\"whatsapp_automations\": true, \"telehealth\": false, \"advanced_analytics\": false}")
  
  // Clinic global settings (e.g. notification templates, invoice prefixes, tax rates)
  settings     Json     @default("{}")
  
  // Dynamic custom fields schema configuration
  customFields Json     @default("{}") @map("custom_fields")
  
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  memberships             Membership[]
  branches                Branch[]
  patients                Patient[]
  appointments            Appointment[]
  medicalRecords          MedicalRecord[]
  prescriptions           Prescription[]
  invoices                Invoice[]
  payments                Payment[]
  communications          Communication[]
  customFieldDefinitions  CustomFieldDefinition[]

  @@map("organizations")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  phone        String?
  fullName     String   @map("full_name")
  avatarUrl    String?  @map("avatar_url")
  passwordHash String?  @map("password_hash") // scrypt: "<salt hex>:<hash hex>"
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships Membership[]

  @@map("users")
}

model Membership {
  id          String       @id @default(uuid()) @db.Uuid
  orgId       String       @map("org_id") @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  role        StaffRole    @default(RECEPTIONIST)
  permissions Json         @default("[]")
  specialty   String?      // If role == DOCTOR (e.g. Orthopedics, Cardiology)
  licenseNo   String?      @map("license_no")
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  doctorAppointments Appointment[]   @relation("DoctorAppointments")
  doctorRecords      MedicalRecord[] @relation("DoctorRecords")
  doctorPrescriptions Prescription[] @relation("DoctorPrescriptions")

  @@unique([orgId, userId])
  @@index([orgId])
  @@index([userId])
  @@map("memberships")
}

model Branch {
  id           String       @id @default(uuid()) @db.Uuid
  orgId        String       @map("org_id") @db.Uuid
  name         String
  code         String?
  address      String?
  phone        String?
  isMain       Boolean      @default(false) @map("is_main")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([orgId])
  @@map("branches")
}

// -------------------------------------------------------------
// 2. PATIENT CRM
// -------------------------------------------------------------

model Patient {
  id               String       @id @default(uuid()) @db.Uuid
  orgId            String       @map("org_id") @db.Uuid
  mrn              String       // Medical Record Number (unique per clinic)
  firstName        String       @map("first_name")
  lastName         String       @map("last_name")
  phone            String       // Primary contact / WhatsApp phone in E.164
  email            String?
  dateOfBirth      DateTime?    @map("date_of_birth")
  gender           String?
  bloodGroup       String?      @map("blood_group")
  emergencyContact Json?        @map("emergency_contact")
  
  // Custom demographic / intake fields defined by clinic
  customFields     Json         @default("{}") @map("custom_fields")
  
  whatsappOptIn    Boolean      @default(true) @map("whatsapp_opt_in")
  isActive         Boolean      @default(true) @map("is_active")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  organization     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  appointments     Appointment[]
  medicalRecords   MedicalRecord[]
  prescriptions    Prescription[]
  invoices         Invoice[]
  communications   Communication[]

  @@unique([orgId, mrn])
  @@index([orgId])
  @@index([orgId, phone])
  @@map("patients")
}

// -------------------------------------------------------------
// 3. APPOINTMENTS & SCHEDULING
// -------------------------------------------------------------

model Appointment {
  id           String            @id @default(uuid()) @db.Uuid
  orgId        String            @map("org_id") @db.Uuid
  branchId     String?           @map("branch_id") @db.Uuid
  patientId    String            @map("patient_id") @db.Uuid
  doctorId     String            @map("doctor_id") @db.Uuid
  
  startTime    DateTime          @map("start_time")
  endTime      DateTime          @map("end_time")
  status       AppointmentStatus @default(SCHEDULED)
  type         String            @default("Consultation") // Walk-in, Follow-up, Telehealth
  reason       String?
  notes        String?
  
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  branch       Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  patient      Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor       Membership        @relation("DoctorAppointments", fields: [doctorId], references: [id])
  
  medicalRecords MedicalRecord[]
  prescriptions  Prescription[]
  invoices       Invoice[]

  @@index([orgId])
  @@index([orgId, startTime])
  @@index([patientId])
  @@index([doctorId])
  @@map("appointments")
}

// -------------------------------------------------------------
// 4. EMR & CLINICAL RECORDS (SOAP)
// -------------------------------------------------------------

model MedicalRecord {
  id            String       @id @default(uuid()) @db.Uuid
  orgId         String       @map("org_id") @db.Uuid
  patientId     String       @map("patient_id") @db.Uuid
  doctorId      String       @map("doctor_id") @db.Uuid
  appointmentId String?      @map("appointment_id") @db.Uuid
  
  // SOAP Notes format
  subjective    String?      @db.Text // Chief complaints, history of present illness
  objective     String?      @db.Text // Clinical examination, physical findings
  assessment    String?      @db.Text // Diagnosis, clinical impressions
  plan          String?      @db.Text // Treatment plan, next steps
  
  // Vitals: { "bp_systolic": 120, "bp_diastolic": 80, "pulse": 72, "temp": 98.6, "spo2": 99, "weight_kg": 70 }
  vitals        Json         @default("{}")
  
  // Attached diagnostics, lab reports
  attachments   Json         @default("[]")
  customFields  Json         @default("{}") @map("custom_fields")
  
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  organization  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  patient       Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor        Membership   @relation("DoctorRecords", fields: [doctorId], references: [id])
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([patientId])
  @@map("medical_records")
}

// -------------------------------------------------------------
// 5. PRESCRIPTIONS (Rx)
// -------------------------------------------------------------

model Prescription {
  id              String       @id @default(uuid()) @db.Uuid
  orgId           String       @map("org_id") @db.Uuid
  patientId       String       @map("patient_id") @db.Uuid
  doctorId        String       @map("doctor_id") @db.Uuid
  appointmentId   String?      @map("appointment_id") @db.Uuid
  
  // Medication items: [{ name, dosage, frequency, duration, instructions }]
  medications     Json         @default("[]")
  advice          String?      @db.Text
  digitalSignature String?     @map("digital_signature")
  pdfUrl          String?      @map("pdf_url")
  
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  organization    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  patient         Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor          Membership   @relation("DoctorPrescriptions", fields: [doctorId], references: [id])
  appointment     Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([patientId])
  @@map("prescriptions")
}

// -------------------------------------------------------------
// 6. BILLING, INVOICES & PAYMENTS
// -------------------------------------------------------------

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  orgId          String        @map("org_id") @db.Uuid
  patientId      String        @map("patient_id") @db.Uuid
  appointmentId  String?       @map("appointment_id") @db.Uuid
  invoiceNumber  String        @map("invoice_number")

  // Line items: [{ description, hsnCode, quantity, unitPrice, taxRate }]
  items          Json          @default("[]")

  // Indian GST breakdown (computed at issue time)
  gstMode        String        @default("INTRA") // INTRA = CGST+SGST | INTER = IGST
  placeOfSupply  String?       @map("place_of_supply") // Org state (default) or patient state for INTER
  clinicGstin    String?       @map("clinic_gstin")   // Snapshot at issue time
  patientGstin   String?       @map("patient_gstin")
  cgstAmount     Decimal       @default(0.00) @map("cgst_amount") @db.Decimal(12, 2)
  sgstAmount     Decimal       @default(0.00) @map("sgst_amount") @db.Decimal(12, 2)
  igstAmount     Decimal       @default(0.00) @map("igst_amount") @db.Decimal(12, 2)

  subtotal       Decimal       @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  discountAmount Decimal       @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount    Decimal       @map("total_amount") @db.Decimal(12, 2)
  balanceDue     Decimal       @map("balance_due") @db.Decimal(12, 2)

  status         InvoiceStatus @default(ISSUED)
  dueDate        DateTime?     @map("due_date")
  notes          String?       @db.Text
  pdfUrl         String?       @map("pdf_url")

  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization   Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment    Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  payments       Payment[]

  @@unique([orgId, invoiceNumber])
  @@index([orgId])
  @@index([patientId])
  @@index([status])
  @@map("invoices")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  orgId          String        @map("org_id") @db.Uuid
  invoiceId      String        @map("invoice_id") @db.Uuid
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod @default(CASH)
  transactionRef String?       @map("transaction_ref")
  receiptNumber  String?       @map("receipt_number")
  paidAt         DateTime      @default(now()) @map("paid_at")
  
  organization   Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoice        Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([invoiceId])
  @@map("payments")
}

// -------------------------------------------------------------
// 7. COMMUNICATIONS & WHATSAPP AUTOMATION
// -------------------------------------------------------------

model Communication {
  id           String        @id @default(uuid()) @db.Uuid
  orgId        String        @map("org_id") @db.Uuid
  patientId    String?       @map("patient_id") @db.Uuid
  channel      CommChannel   @default(WHATSAPP)
  direction    CommDirection @default(OUTBOUND)
  
  templateName String?       @map("template_name") // Meta template (e.g. "bill_issued_v1")
  messageBody  String        @map("message_body") @db.Text
  mediaUrl     String?       @map("media_url")     // PDF or image link sent with message
  
  status       CommStatus    @default(QUEUED)
  externalId   String?       @map("external_id")   // WhatsApp message ID (wamid.HBg...)
  metadata     Json          @default("{}")        // Provider payloads, error messages, delivery timestamps
  
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  patient      Patient?      @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([patientId])
  @@index([status])
  @@index([externalId])
  @@map("communications")
}

// -------------------------------------------------------------
// 8. DYNAMIC CUSTOM FIELDS DEFINITIONS
// -------------------------------------------------------------

model CustomFieldDefinition {
  id          String       @id @default(uuid()) @db.Uuid
  orgId       String       @map("org_id") @db.Uuid
  entityType  String       @map("entity_type") // "PATIENT", "APPOINTMENT", "RECORD"
  fieldKey    String       @map("field_key")   // e.g. "referring_physician"
  fieldLabel  String       @map("field_label") // e.g. "Referring Physician"
  fieldType   String       @map("field_type")  // "text", "number", "select", "date", "boolean"
  options     Json         @default("[]")      // For select/multiselect fields
  isRequired  Boolean      @default(false) @map("is_required")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, entityType, fieldKey])
  @@index([orgId])
  @@map("custom_field_definitions")
}

